# ==============================================================================
# CineStream Environment Configuration
# Copy this file to .env.local and populate with your own project credentials.
# Never commit real credentials or .env.local to version control.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Database Configuration (PostgreSQL on Supabase, Neon, or local Postgres)
DATABASE_URL=postgresql://username:password@localhost:5432/cinestream

# Supabase Managed API & Auth (Optional - for Supabase Auth integration)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# The Movie Database (TMDb) API (Optional - for automated catalog sync jobs)
TMDB_API_KEY=your_tmdb_v3_api_key

# Security & Sessions
SESSION_SECRET=your_random_64_char_session_signing_secret
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Webhook Alerting (Optional Discord or Telegram bot webhook for broken stream alerts)
ALERT_WEBHOOK_URL=
