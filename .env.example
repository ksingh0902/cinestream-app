# ==========================================
# CineMyMovies Environment Configuration
# ==========================================

# --- Security & Private Access (Required for Production) ---
# Random 32+ character secret for cryptographic signing of session cookies
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_or_secret

# Initial credentials (used only on first startup to initialize the database)
# Once initialized or changed in the admin panel, persistent storage retains the passwords.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_admin_password

VIEWER_USERNAME=viewer
VIEWER_INITIAL_PASSWORD=replace_with_a_shared_viewer_password

# Session lifetime in seconds (default: 604800 = 7 days)
SESSION_MAX_AGE_SECONDS=604800

# Environment mode ('production' forces Secure cookies; 'development' allows local HTTP)
ENVIRONMENT=production

# Production decoupling: keep background crawlers out of the request-serving container
DISABLE_AUTO_SYNC=1
ENABLE_AUTO_SYNC=0

# --- Persistent Storage ---
# The production container mounts this catalogue database read-only at /app/yomovies.db.
DB_PATH=yomovies.db
AUTH_DB_PATH=cinemymovies.sqlite3

# Nginx verifies these short-lived secure_link tokens before it relays HLS bytes.
# Never commit the real value. List only provider hosts you have tested from the VM.
HLS_SEGMENT_SIGNING_SECRET=replace_with_a_long_random_secret
HLS_SEGMENT_TTL_SECONDS=300
HLS_PROXY_ALLOWED_HOSTS=ydc1wes.me,vsyshost.com,watchkar.com
UVICORN_WORKERS=1

# --- Scraper & Upstream Sources ---
SITE_BASE=https://yomovies.wine
SITE_MIRRORS=https://yomovies.wine,https://yomovies.mom
A4M_MIRRORS=https://ask4movietv.cyou
FBOX_MIRRORS=https://fbox.gd
TMDB_API_KEY=
PLAYER_TTL_S=21600
CRAWL_DELAY=0.6
CRAWL_WORKERS=4
SYNC_INTERVAL_HOURS=12
