# ==============================================================================
# CineMyMovies Environment Configuration
# Copy this file to .env and customize as needed.
# ==============================================================================

# Port and Network Configuration
PORT=8000
HOST=0.0.0.0

# Database Path
DB_PATH=yomovies.db

# Upstream Mirrors (Comma-separated, first healthy mirror wins)
SITE_MIRRORS=https://yomovies.wine

# Fallback Embed Host
DEFAULT_EMBED_HOST=https://speedostream1.com

# Stream Resolution & TTL Settings
STREAM_TTL=1800
CRAWL_DELAY=0.6
HTTP_TIMEOUT=25
