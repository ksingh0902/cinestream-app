# Git and version control
.git
.gitignore
.github

# Environment files (never bake local dev credentials into Docker image)
.env
.env.*
*.env

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/

# Node / frontend build caches
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratch and temporary directories
scratch/
_debug/
.tempmediaStorage/
*.log

# Backups and temporary databases
backups/
*.db-shm
*.db-wal
pre-*.sqlite3
